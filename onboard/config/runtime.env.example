# ARGUS Raspberry Pi 5 runtime configuration
# Relative paths are resolved from onboard/, not the repository root.

# Hailo-8용 YOLOX HEF. Hailo-8L 또는 다른 가속기용 HEF는 사용할 수 없습니다.
ARGUS_HEF=models/deployed/model.hef

# 검증한 HEF와 대응 라벨을 models/deployed/에 함께 배치합니다.
# COCO80 모델이면 config/coco80.txt를 복사하고, 자체 모델이면 해당 class ID 순서의 라벨을 복사합니다.
ARGUS_LABELS=models/deployed/labels.txt

# auto selects frame_source from the profile; current REAL_IR uses ir_v4l2.
# Set ARGUS_FRAME_SOURCE=ir_sdk explicitly to use the TE-EV1 SDK capture.
ARGUS_PROFILE=REAL_IR
ARGUS_FRAME_SOURCE=auto
ARGUS_IR_CAPTURE=/home/user/thessen_raw14_viewer/build/i3_raw14_capture
ARGUS_IR_DEVICE=0
ARGUS_IR_TIMEOUT=15
ARGUS_IR_PREPROCESS=minmax
ARGUS_CAMERA=/dev/video0
ARGUS_WIDTH=640
ARGUS_HEIGHT=480
ARGUS_FPS=30
ARGUS_FOURCC=MJPG

ARGUS_SCORE_THRESHOLD=0.35
ARGUS_FRAME_QUEUE_SIZE=2
ARGUS_LOG_EVERY=30

# 서비스 시작 시 장치·카메라·HEF·라벨을 검사합니다.
ARGUS_VERIFY_ON_START=1
ARGUS_STARTUP_TIMEOUT=30

# vision/npu_input/jpeg 발행 (Windows 모니터링 앱 디버그용). 기본 꺼짐(0).
# 실비행/실제 임무 중에는 0으로 유지하십시오 (docs/BUS_CONTRACT.md 운용 원칙 참조).
ARGUS_PUBLISH_NPU_INPUT=0
ARGUS_NPU_INPUT_MAX_FPS=15
ARGUS_NPU_INPUT_JPEG_QUALITY=80

# C++ orchestrator options (actual runtime.env is unchanged)
ARGUS_PUBLISH_PREVIEW=0
ARGUS_PREVIEW_MAX_FPS=10
ARGUS_JPEG_QUALITY=75
ARGUS_WORKER_TIMEOUT_MS=10000
