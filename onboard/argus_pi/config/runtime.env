# ARGUS Raspberry Pi 5 runtime configuration
# Relative paths are resolved from the project directory.

# Hailo-8용 YOLOX HEF. Hailo-8L 또는 다른 가속기용 HEF는 사용할 수 없습니다.
# 이전 COCO80 모델: ARGUS_HEF=models/yolox_s_leaky_hailo8_zoo_v2.19.0.hef
# ARGUS 2026-10-26: restored 480x640 single-channel HEF; native 640x480 source needs no padding.
# ARGUS 2026-10-29: same v7.3 480x640 1ch quantized HAR, compiler optimization max (1 context).
# NPU 75.8 -> 500.8 FPS, 10.4 -> 6.0 ms; chip output identical to the default HEF (test 50 images).
# Previous: ARGUS_HEF=assets/models/yolox_s_leaky_480x640_1ch.hef
# ARGUS 2026-10-30: 3-class (tank, person, car) ft_b1 480x640 1ch max HEF (1 context, Pi NPU 7.17 ms).
# To switch models: ./switch_model.sh (list) / ./switch_model.sh tank_1ch_max (previous tank-only) / tank_v7.3_640_3ch
# Previous: ARGUS_HEF=assets/models/yolox_s_leaky_480x640_1ch_max.hef, ARGUS_LABELS=config/tank_labels.txt
# ARGUS 2026-11-03: v7.3 1-class 480x640 1ch max (tank_1ch_max)로 되돌림. 3클래스 toy1 + 5번 + A안 상태는 runtime.env.before_v73_1103
ARGUS_HEF=assets/models/yolox_s_leaky_3cls_indoor_TA_480x640_1ch_max.hef

# 기본 COCO 가중치 HEF는 coco80.txt, 사용자 학습 모델은 해당 라벨 파일을 사용합니다.
# 이전 COCO80 라벨: ARGUS_LABELS=config/coco80.txt
# tank 모델 라벨 (~/tank_model/labels.json: num_classes=1, ["tank"])
ARGUS_LABELS=config/tank_person_car_labels.txt

# IR TE-V2 Mini: SDK standard NUC serialized between receives (FPA delta 1 C).
ARGUS_FRAME_SOURCE=ir_sdk
ARGUS_IR_CAPTURE=bin/i3_managed_capture
I3_MANAGED_NUC=1
# 학습 데이터와 동일: 팀원 GUI "상·하한 Plateau · Adaptive"(EMA alpha 0.15), 노이즈 제거 없음.
# 고정값(3.0/0.20) 버전은 double_plateau.
ARGUS_IR_PREPROCESS=double_plateau_adaptive
# SDK RecvImage가 가끔 멈춤(2026-10-06 관찰). 첫 프레임은 연결 셔터 보정으로 4~5초 걸리므로 8초.
ARGUS_IR_TIMEOUT=8

# ir_v4l2/replay sources only.
ARGUS_CAMERA=/dev/video0
ARGUS_WIDTH=640
ARGUS_HEIGHT=480
ARGUS_FPS=30
ARGUS_FOURCC=MJPG

# 2026-11 클래스별 점수 기준 적용 전 값: ARGUS_SCORE_THRESHOLD=0.7
ARGUS_SCORE_THRESHOLD=0.25
ARGUS_FRAME_QUEUE_SIZE=2
ARGUS_LOG_EVERY=1

# 서비스 시작 시 장치·카메라·HEF·라벨을 검사합니다.
ARGUS_VERIFY_ON_START=1
ARGUS_STARTUP_TIMEOUT=30

# 2026-11-15 영상 전송이 흑백 영상(gray8)을 쓰므로 모델 입력 JPEG는 끈다. 되돌리기: 1로 바꾸고 탐지 재시작
ARGUS_PUBLISH_NPU_INPUT=0
ARGUS_NPU_INPUT_MAX_FPS=30
ARGUS_NPU_INPUT_JPEG_QUALITY=80

# ThermalViewer JPEG: core camera/model/NUC choices follow this runtime.
ARGUS_VIEWER_CPP=/home/user/ARGUS/bin/argus-onboard
ARGUS_VIEWER_JPEG_MAX_FPS=15
ARGUS_VIEWER_JPEG_QUALITY=90
# 2026-11-25 batch 4: 읽는 곳이 없던 ARGUS_TRACKING_OBSERVATIONS_ENDPOINT (5556) 를 지웠다. 관측은
# config/runtime.json endpoints.vision (팀 6374) 에서 받는다

# 2026-10-31 전처리 C++/OpenMP (vendor/plateau_native, Python과 출력 바이트 단위 동일, Pi 7.4 -> 1.6 ms).
# 끄려면 ARGUS_NATIVE_PREPROCESS=0. OMP_WAIT_POLICY=passive: 다른 프로세스가 CPU를 쓸 때 4스레드가 느려지지 않게 함.
ARGUS_NATIVE_PREPROCESS=1
# 2026-11-05 이전 값 4. 2스레드가 속도는 같고 CPU가 적으며 FIFO일 때 코어 2개를 남긴다.
ARGUS_NATIVE_THREADS=2
OMP_WAIT_POLICY=passive

# 2026-11 클래스별 점수 기준 (라벨 순서 tank,person,car). 끄려면 이 줄을 비우고 ARGUS_SCORE_THRESHOLD를 위 이전 값으로.
ARGUS_CLASS_SCORE_THRESHOLDS=0.5,1.01,0.35

# 2026-11 겹치는 다른 클래스 상자 지우기 (남길라벨:지울라벨:IoU). 끄려면 값을 비움.
ARGUS_CLASS_SUPPRESS=tank:car:0.3

# 2026-11-05 탐지(argus-onboard, 카메라, Python 워커) SCHED_FIFO 우선순위. 0이면 끔. 권한이 없으면 일반으로 실행.
ARGUS_DETECTION_SCHED_FIFO=0

# 2026-11-09 박스별 RAW14 열 외형 계산 (같은 대상 확인용). 0=끔(기본), 1=켬. 바꾼 뒤 영상 생산 재시작.
ARGUS_THERMAL_SIGNATURE=1
# 2026-11-11 DDS 기본 켬 (0이면 ZeroMQ만). 1이면 탐지 결과를 ZeroMQ와 DDS(argus/perception/observations)로 함께 발행 (ARGUS_WITH_DDS=ON 빌드 필요)
# 2026-11-16 DDS 미도입 결정: 기본 0 (탐지 결과는 ZeroMQ msgpack만)
ARGUS_DDS_PUBLISH=${ARGUS_DDS_PUBLISH:-0}

# 2026-11-15 C++ 탐지 프로세스와 흑백 영상(vision/frame/gray8 -> H.264 한 번).
# 되돌리기: 아래 세 줄을 지우면 Python 탐지 프로세스와 예전 JPEG 영상 경로로 돌아간다. 전부 되돌리기는 ~/argus_cpp_worker/rollback_1115.sh
ARGUS_VISION_WORKER=bin/argus_vision_worker
ARGUS_PUBLISH_GRAY8=1
ARGUS_GRAY8_MAX_FPS=30
# 2026-11-15 탐지 프로세스가 JPEG(미리보기, 모델 입력)를 만들지 않는다. 시작 확인은 흑백 영상으로 한다.
# 되돌리기: 이 줄을 지우고 탐지 재시작 (예전 뷰어 중계, 지상 기록 도구는 JPEG가 있어야 동작)
ARGUS_WORKER_NO_JPEG=1
# 2026-11-15 GUI 영상 30 fps (DX Campus 시험: 손실 1.1%, 평균 0.9 Mbps). 15로 바꾸면 예전 속도
ARGUS_GCS_VIDEO_FPS=30
