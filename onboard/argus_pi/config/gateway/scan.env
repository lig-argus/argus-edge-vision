# 2026-11-18 탐색(45002) 방식 (argus_fc_gateway). sector = 좌우 왕복(+60/-60/0), turn = 기존 한 방향 360도 회전.
# 바꾼 뒤 게이트웨이(run_pi_fc.sh)를 다시 띄워야 적용된다. 파일이 없거나 turn이면 기존 회전.
# 2026-11-19 사용자 지시: 오른쪽 180도 한 방향 회전(turn)으로 변경. 이전 값 sector.
ARGUS_SCAN_PATTERN=turn
# 2026-11-18 왕복 중간 정지: 1 = 양 끝에서만 멈추는 연속 왕복(기본), 0 = 구간 안 20도마다 0.5초 정지.
ARGUS_SCAN_SECTOR_CONTINUOUS=1
# 2026-11-18 왕복 시작 방향 (GUI가 속도를 보내지 않을 때): left = 왼쪽(반시계) 먼저, right = 오른쪽 먼저.
ARGUS_SCAN_SECTOR_FIRST=left
# 2026-11-18 왕복 전체 폭(도). 80 = 좌우 40도. 0 초과 180 이하, 없으면 120.
ARGUS_SCAN_SECTOR_WIDTH_DEG=80
