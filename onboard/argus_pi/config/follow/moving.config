
# 테스트 전용 값이며 운용 기본값으로 사용하지 않는다.
observations_sub_endpoint=tcp://127.0.0.1:6356
status_pub_endpoint=tcp://127.0.0.1:6359
command_rep_endpoint=tcp://127.0.0.1:6360
px4_connection_url=udpin://127.0.0.1:14540
target_class_ids=0,1,2
image_width=640
image_height=480
fx=1083.3333333333335
fy=1083.3333333333335
cx=320.0
cy=240.0
camera_to_body=0,-0.7071067811865475,0.7071067811865476,1,0,0,0,0.7071067811865476,0.7071067811865475
camera_offset_body_m=0.125,0,-0.242
box_anchor_x=0.5
box_anchor_y=0.5
target_anchor_height_above_ground_m=0.08
ground_down_m=0
hold_down_m=-1.9
max_pose_bracket_ms=100
max_pose_receive_age_ms=200
# 2026-11-10 사용자 확정: 박스가 화면 위쪽(평균 -0.19)에 있어 거리 2.0→1.8m (기존 2.0)
desired_range_m=1.8
range_deadband_m=0.3
yaw_kp_deg_s_per_deg=4.0
max_yaw_rate_deg_s=75.0
yaw_alignment_deg=25.0
forward_gain_m_s_per_m=0.6
max_forward_m_s=1.5
altitude_gain=0.8
max_vertical_m_s=0.7
edge_margin_fraction=0.05
command_ttl_ms=100
max_pose_age_ms=200
input_score_floor=0.1
bytetrack_high_score=0.3
new_track_score=0.4
lost_track_ttl_s=0.7
max_prediction_gap_s=0.5
max_observation_age_ms=250
max_tracks_age_ms=250
enable_rotation_cmc=false
max_frame_interval_ms=500
max_rotation_deg=35
control_period_ms=50
prestream_setpoint_count=15
prestream_interval_ms=100
offboard_start_timeout_ms=3000
hold_confirm_timeout_ms=2000
watchdog_period_ms=25

external_tracks=true
diagnostics_csv=control.csv
enable_target_recovery=true
target_recovery_ground_gate_m=2
# 2026-11-10 가림 대응(제안값): 지면 재획득 게이트를 2m + 0.5m/s×공백으로 키우고 4m에서 멈춘다.
# 같은 ID도 0.5초 넘게 비었다가 돌아오면 CV 예측 위치에서 그 게이트 안일 때만 바로 믿는다.
target_recovery_gate_growth_m_s=0.5
target_recovery_gate_max_m=4.0
trusted_return_check_ms=500
max_horizontal_accel_m_s2=1.0
max_yaw_accel_deg_s2=300.0
ground_vector_follow=true
motion_ground_follow=true
ground_center_offset_m=0.0
allow_competitor_departure=true
motion_history_s=2.0
motion_history_min_s=1.5
motion_history_min_samples=20
motion_fit_max_rmse_m=0.4
motion_fit_acceleration=true
observed_path_rear_follow=false
rear_path_sample_spacing_m=0.5
short_motion_enabled=true
short_motion_window_s=0.25
short_motion_min_span_s=0.15
short_motion_min_samples=4
short_motion_confirmation_s=0.05
short_motion_stop_speed_m_s=0.15
short_motion_resume_speed_m_s=0.25
short_motion_max_rmse_m=0.1
allow_recovery_during_priming=true
camera_motion_guard=true
fov_velocity_p_acc=1.8
ground_contact_anchor=true
body_standoff_follow=true
pixeagle_pid_enabled=true
pid_forward_gains=0.60,0.02,0.55
pid_right_gains=0.60,0.02,0.55
pid_yaw_gains=12.0,0.5,1.5
pid_altitude_gains=2.0,0.03,0.05
pid_anti_windup=true
pid_back_calculation=0.1
pid_yaw_smoothing_enabled=true
pid_yaw_deadzone_deg_s=0.5
pid_yaw_max_change_deg_s2=300.0
pid_yaw_alpha=0.7
pid_yaw_speed_scaling=false
pid_yaw_min_speed_m_s=0.5
pid_yaw_max_speed_m_s=5.0
pid_yaw_low_speed_factor=0.5
velocity_feedforward_follow=true
max_backward_m_s=0.8
max_backward_accel_m_s2=1.8
reverse_range_margin_m=0.2
camera_descent_m=0.7
camera_min_height_m=1.0
# 2026-11-10: 옆 간격은 추종 거리보다 작아야 한다(1.9→1.7). point 모드 경로에는 쓰이지 않는다.
follow_side_offset_m=1.7
reset_motion_on_stop_or_reverse=true
predictive_follow=true
coherent_ground_anchor_motion=true
predictive_min_height_m=1.1
# 2026-11-09 고도 고정항(1.8m)이 상한에 붙지 않도록 실내 허용 상한 2.0m까지 올림 (기존 1.9)
predictive_max_height_m=2.0
target_recovery_max_gap_ms=4000

yaw_only=false
prefer_selected_continuity=true
estimated_speed_deadzone_m_s=0.05
# V3 (userpc SITL 검증본 20261104) 추종 기능. 실외 PID/yaw 설정에는 넣지 않는다.
v3_pampc_point_profile=1
v3_image_velocity_weight=0.25
v3_predictive_integral=true
v3_discard_recheck=true
v3_box_motion_guard=true
v3_fresh_contact_velocity=true
# 2026-11-09 PAMPC point 고도 고정항(지면 기준 1.8m, ±0.05m 무시)과 수직 명령 무시 구간(0.1m/s).
# 21:50 비행에서 point 모드가 현재 높이를 기준으로 삼아 1.55~1.91m로 출렁였다. 0으로 두면 기존 동작.
predictive_height_anchor_m=1.8
predictive_height_anchor_weight=10
predictive_height_anchor_deadband_m=0.05
predictive_vertical_deadband_m_s=0.1
# 2026-11-10 GAP_CV 동안 CV 속도를 예측·시작 명령에 넣는다(공백 중 감속 계획 방지). false면 기존 동작.
v35_gap_cv_feedforward=true
# 2026-11-10 송신 slew 한도 충돌 시 거부(HOLD) 대신 변화율 한도 안으로 줄여 보낸다. false면 기존 동작.
v35_slew_reconcile=true
# 2026-11-10 GAP_CV 출발점 1초 넘게 낡으면 의심 박스로도 갱신, GAP_CV 예측 실패 시 HOLD 대신 짧은 공백 Hover.
v35_cv_reference_refresh=true
v35_gap_invalid_hover=true
# 2026-11-10 정지 대상 주위 원 운동 억제: point 모드 둘레 방향 상대속도 벌점(0=기존). 실외 기록 Replay 근거,
# 실내 값은 사용자 지시로 실외와 같은 10 적용. 실내 Replay·실비행 미검증.
v35_point_tangential_weight=10
# 2026-11-10 point 거리 무시 구간 0.3→0.4m (10:08 진동 구간 Replay 1초대 진동 -32%, 실비행 미확인). 0이면 기본.
v35_point_range_deadband_m=0.4

# V3.2 native ID priority; deployment selection.
trust_selected_id=true
v32_sent_command_slew=true
v32_cv_ten_frame=true
# 2026-11-09 속도 기억이 없을 때(경우 1)도 경우 2와 같은 2.9초 기한까지 제자리 대기
short_gap_hover_ms=3000
# 2026-11-09 열 외형 같은 대상 확인: off(기존 동작) / log(기록만) / on(판단에 사용). 바꾼 뒤 컨트롤러 재시작.
# on·log는 영상 생산 쪽 계산(config/runtime.env 의 ARGUS_THERMAL_SIGNATURE=1)이 켜져 있어야 값이 들어온다.
thermal_identity=on
thermal_identity_log=/home/user/ARGUS/run/follow_b/thermal-identity.jsonl
# 2026-11-10 열 외형 원래 기준 고정: 유사도 0.85 이상일 때만 기억 갱신, 원래·갱신 기준 모두 0.75
# 미만이면 비교 후보가 없어도 불일치(실내 15:28 다른 물체 같은 ID 추종). false면 기존 동작.
v35_thermal_anchor_gate=true
# 2026-11-13 사용자 확정: 신원 판단 문맥(떨어지면 외형으로 버리지 않고 계속 갱신, 가까우면 기억 고정 후
# 떨어진 뒤 1초 비교, 돌아온 같은 ID는 5프레임 검증, 공백 뒤 다른 ID는 안 따라감). 완화 정책은 끔.
v36_identity_context=true
v36_new_id_relaxed=false
# 2026-11-12 이 설정이 어느 추종 모드인지 (게이트웨이 정비 선택값과 같아야 함).
follow_controller_profile=predictive
# 2026-11-19 사용자 지시(PAMPC 모델 수정 3번, 5번). 아래 키를 지우거나 0/false로 두면 기존 동작.
# 3번: 예측 rollout의 기체 응답 이득(1/s). 2026-11-18 실비행 8회 적합값(수평 0.8~0.9, 수직 1.5).
# fov_velocity_p_acc(1.8)는 PX4 가속 setpoint 이득이라 송신 변화율 예산과 시드에 그대로 쓴다.
# GAP_CV 시야 예측(cv_gap_visibility)은 의도적으로 기존 1.8과 기존 높이 기준을 그대로 쓴다.
pampc_plant_horizontal_response=0.85
pampc_plant_vertical_response=1.5
# 5번: 계획기 높이 기준과 t0 재투영 자세를 관측(producer)과 같게 한다 (레이저 지면 평면, -50ms 자세).
# 투영 자세에는 ARGUS_CAMERA_PITCH_SCALE 배율도 들어 있다 (배포값 1.0).
# predictive_height_anchor_m=1.8은 레이저 기준이 되지만, 고정 높이 + 무시 구간이 EKF 상한 2.0m보다
# pampc_ceiling_margin_m 이상 아래가 되도록 줄인다. 이번 기록(평면 약 -0.12m)에서는 레이저 약 1.73m,
# EKF 약 1.85m로 난다 (기존 EKF 1.8m, 레이저 약 1.68m보다 EKF로 약 0.05m 높다).
pampc_use_producer_ground=true
# 5번 안전 상수 (pampc_use_producer_ground=true일 때만 작용, 지우면 아래 기본값).
# 평면이 ground_down_m과 이보다 더 다르면 그 프레임 값은 쓰지 않는다 (m, 0.05..0.5, 기본 0.2).
pampc_producer_ground_max_deviation_m=0.2
# 관측이 1초 넘게 낡거나(공백) 필드가 없을 때 마지막 평면을 유지하는 시간 (s, 0..10, 기본 5).
pampc_producer_ground_hold_s=5
# 계획기 지면 기준의 변화율 상한 (m/s, 0..1, 0=제한 없음, 기본 0.05). 양방향, 시작 때 포함.
pampc_ground_datum_rate_m_s=0.05
# 고정 높이 + 무시 구간을 EKF 상한(predictive_max_height_m)보다 이만큼 아래로 둔다 (m, 0..0.3, 기본 0.1).
pampc_ceiling_margin_m=0.1
# 진단 기록(decision.jsonl의 pampc_model: 사용 기준, 줄인 높이, 영상 예측 1/3/5/10/20 단계, 계획 3 블록).
# false면 기존 기록.
pampc_model_log=true
