cmake_minimum_required(VERSION 3.16)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
include(CTest)
find_package(Threads REQUIRED)
find_path(MSGPACK_INCLUDE_DIR msgpack.hpp HINTS ${ARGUS_ROOT}/vendor/yaw/msgpack/include REQUIRED)
find_path(ZMQ_INCLUDE_DIR zmq.h HINTS ${ARGUS_ROOT}/vendor/yaw/zmq/include REQUIRED)
find_library(ZMQ_LIBRARY NAMES zmq libzmq.so.5 REQUIRED)
add_library(argus_headers INTERFACE)
target_include_directories(argus_headers INTERFACE ${ARGUS_ROOT}/src)
add_library(observation_contract STATIC
    ${ARGUS_ROOT}/src/argus/perception/observations/observation_v2.cpp
    ${ARGUS_ROOT}/src/argus/perception/observations/observation_v2_factory.cpp
    ${ARGUS_ROOT}/src/argus/perception/observations/observation_inbox.cpp)
target_link_libraries(observation_contract PUBLIC argus_headers)
add_library(observation_msgpack STATIC ${ARGUS_ROOT}/src/argus/perception/observations/observation_v2_codec.cpp)
target_include_directories(observation_msgpack SYSTEM PRIVATE ${MSGPACK_INCLUDE_DIR})
target_link_libraries(observation_msgpack PUBLIC observation_contract)
add_library(observation_bus STATIC
    ${ARGUS_ROOT}/src/argus/transport/zeromq/zeromq_observation_bus.cpp
    ${ARGUS_ROOT}/src/argus/transport/zeromq/observation_bus_worker.cpp)
target_include_directories(observation_bus SYSTEM PRIVATE ${MSGPACK_INCLUDE_DIR} ${ZMQ_INCLUDE_DIR})
target_link_libraries(observation_bus PUBLIC observation_msgpack ${ZMQ_LIBRARY} Threads::Threads)
# 2026-11-25 batch 2: tracking/tracks, tracking/status 는 팀 규약(ZeroMQ + protobuf, 6375). 팀 ZmqBus,
# team_wire, Pi protobuf 변환 (cmake/argus_bus.cmake, proto/README.md)
include(${ARGUS_ROOT}/cmake/argus_bus.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/tracking_target_modules.cmake)
argus_add_target_manager_core()
argus_add_target_monitor_bus()

argus_add_tracking_monitor()
if(BUILD_TESTING)
    foreach(pair IN ITEMS "target_selector_test;target_selector" "short_motion_estimator_test;short_motion")
        list(GET pair 0 source)
        list(GET pair 1 name)
        add_executable(${name} ${ARGUS_ROOT}/tests/yaw/contracts/${source}.cpp)
        target_compile_options(${name} PRIVATE -UNDEBUG)
        target_link_libraries(${name} PRIVATE target_manager_core)
        add_test(NAME ${name} COMMAND ${name})
    endforeach()
    add_executable(target_manager_import ${ARGUS_ROOT}/tests/yaw/contracts/target_manager_import_test.cpp)
    target_compile_options(target_manager_import PRIVATE -UNDEBUG)
    target_link_libraries(target_manager_import PRIVATE target_manager_core)
    add_test(NAME target_manager_import COMMAND target_manager_import)
    add_executable(target_view_snapshot ${ARGUS_ROOT}/tests/yaw/contracts/target_view_snapshot_test.cpp)
    target_compile_options(target_view_snapshot PRIVATE -UNDEBUG)
    target_include_directories(target_view_snapshot SYSTEM PRIVATE ${MSGPACK_INCLUDE_DIR})
    target_link_libraries(target_view_snapshot PRIVATE target_view_core)
    add_test(NAME target_view_snapshot COMMAND target_view_snapshot)
    find_package(Python3 COMPONENTS Interpreter)
    if(Python3_FOUND)
        add_test(NAME monitor_integration COMMAND ${Python3_EXECUTABLE} ${ARGUS_ROOT}/tests/yaw/integration/tracking_monitor_test.py $<TARGET_FILE:tracking_target_monitor>)
        set_tests_properties(monitor_integration PROPERTIES TIMEOUT 45)
        set_tests_properties(monitor_integration PROPERTIES ENVIRONMENT "ARGUS_MONITOR_IMAGE_ENABLED=0")
    endif()
endif()
