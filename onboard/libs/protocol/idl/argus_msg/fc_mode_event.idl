// fc/mode_event: mavlink_gateway → 추종 제어 (fc_mode_event.proto 에 대응)
// .proto 와 다른 점: seq 없음 (순번은 DDS 가 표본마다 부여)
#include "common.idl"

module argus {
    module idl {
        enum OffboardExitCause {
            OFFBOARD_EXIT_CAUSE_NONE,          // Offboard 이탈이 아닌 모드 변경
            OFFBOARD_EXIT_CAUSE_PILOT_SWITCH,  // 조종사가 RC 또는 통제기로 모드를 바꿈
            OFFBOARD_EXIT_CAUSE_FAILSAFE,      // FC failsafe
            OFFBOARD_EXIT_CAUSE_UNKNOWN
        };

        struct FcModeEvent {
            FlightMode mode;
            @optional uint64 request_command_id;
            OffboardExitCause exit_cause;
            int64 received_monotonic_ns;  // RPi CLOCK_MONOTONIC, ns
        };
    };
};
