# 통제기 모듈 타깃을 만드는 함수. 모듈마다 gcs/<모듈>/CMakeLists.txt 에서 부른다.
#   argus_gcs_add_library(<모듈> SOURCES <파일>... [DEPS <모듈>...] [QT <구성 요소>...] [EXTERNAL ...])
#   argus_gcs_add_library(<모듈> HEADER_ONLY [DEPS ...] [QT ...] [EXTERNAL ...])
#   argus_gcs_add_executable(<모듈> <실행 파일 이름> SOURCES ... [DEPS ...] [QT ...] [EXTERNAL ...])
#   argus_gcs_add_test(<테스트 이름> SOURCES <파일>... LIBS <타깃>...)
# 모듈 폴더: gcs/<모듈>/include/argus/gcs/<모듈>/, src/, test/. namespace 는 argus::gcs::<모듈>.
# 타깃은 argus_gcs_<모듈>, 별칭 argus::gcs::<모듈>.
# DEPS, QT, EXTERNAL 이 module_rules.cmake 의 허용 범위를 넘으면 설정 단계에서 멈춘다.
# include 가 선언한 DEPS 를 넘는지는 테스트 gcs_module_deps_test 가 확인한다 (check_module_deps.cmake).

# 허용 의존을 등록한다 (module_rules.cmake)
function(argus_gcs_module_rule module)
    cmake_parse_arguments(ARG "" "" "DEPS;QT;EXTERNAL" ${ARGN})
    set_property(GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_DEFINED TRUE)
    set_property(GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_DEPS "${ARG_DEPS}")
    set_property(GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_QT "${ARG_QT}")
    set_property(GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_EXTERNAL "${ARG_EXTERNAL}")
endfunction()

# 선언한 의존이 허용 범위 안인지 확인한다. 의존 모듈의 허용 Qt 구성 요소가 이 모듈의 허용 범위 안인지도
# 확인해, 의존 모듈을 거쳐 금지된 구성 요소가 들어오지 않게 한다
function(_argus_gcs_check_rule module deps qt external)
    get_property(defined GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_DEFINED)
    if(NOT defined)
        message(FATAL_ERROR "gcs 모듈 ${module}: gcs/cmake/module_rules.cmake 에 허용 의존이 없다")
    endif()
    get_property(allowed_deps GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_DEPS)
    get_property(allowed_qt GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_QT)
    get_property(allowed_external GLOBAL PROPERTY ARGUS_GCS_RULE_${module}_EXTERNAL)
    foreach(dep IN LISTS deps)
        if(NOT dep IN_LIST allowed_deps)
            message(FATAL_ERROR "gcs 모듈 ${module}: ${dep} 에 의존할 수 없다 (module_rules.cmake)")
        endif()
        get_property(dep_qt GLOBAL PROPERTY ARGUS_GCS_RULE_${dep}_QT)
        foreach(component IN LISTS dep_qt)
            if(NOT component IN_LIST allowed_qt)
                message(FATAL_ERROR
                        "gcs 모듈 ${module}: 의존 모듈 ${dep} 의 Qt ${component} 가 허용 범위 밖이다")
            endif()
        endforeach()
    endforeach()
    foreach(component IN LISTS qt)
        if(NOT component IN_LIST allowed_qt)
            message(FATAL_ERROR "gcs 모듈 ${module}: Qt ${component} 를 쓸 수 없다 (module_rules.cmake)")
        endif()
    endforeach()
    foreach(library IN LISTS external)
        if(NOT library IN_LIST allowed_external)
            message(FATAL_ERROR "gcs 모듈 ${module}: ${library} 를 쓸 수 없다 (module_rules.cmake)")
        endif()
    endforeach()
endfunction()

# 타깃에 의존을 연결하고, include 검사가 읽을 모듈 목록에 등록한다
function(_argus_gcs_link target scope module deps qt external)
    foreach(dep IN LISTS deps)
        target_link_libraries(${target} ${scope} argus::gcs::${dep})
    endforeach()
    foreach(component IN LISTS qt)
        target_link_libraries(${target} ${scope} Qt6::${component})
    endforeach()
    if(mavlink IN_LIST external)
        target_link_libraries(${target} ${scope} argus_mavlink)
    endif()
    if(gstreamer IN_LIST external)
        target_link_libraries(${target} ${scope} PkgConfig::ARGUS_GCS_GSTREAMER)
    endif()
    set_property(GLOBAL APPEND PROPERTY ARGUS_GCS_MODULES ${module})
    set_property(GLOBAL PROPERTY ARGUS_GCS_MODULE_${module}_DIR ${CMAKE_CURRENT_SOURCE_DIR})
    set_property(GLOBAL PROPERTY ARGUS_GCS_MODULE_${module}_DEPS "${deps}")
endfunction()

function(argus_gcs_add_library module)
    cmake_parse_arguments(ARG "HEADER_ONLY" "" "SOURCES;DEPS;QT;EXTERNAL" ${ARGN})
    _argus_gcs_check_rule(${module} "${ARG_DEPS}" "${ARG_QT}" "${ARG_EXTERNAL}")
    set(target argus_gcs_${module})
    if(ARG_HEADER_ONLY)
        add_library(${target} INTERFACE)
        set(scope INTERFACE)
    else()
        add_library(${target} STATIC ${ARG_SOURCES})
        set(scope PUBLIC)
    endif()
    add_library(argus::gcs::${module} ALIAS ${target})
    target_include_directories(${target} ${scope} ${CMAKE_CURRENT_SOURCE_DIR}/include)
    target_link_libraries(${target} ${scope} argus_gcs_warnings)
    _argus_gcs_link(${target} ${scope} ${module} "${ARG_DEPS}" "${ARG_QT}" "${ARG_EXTERNAL}")
endfunction()

function(argus_gcs_add_executable module name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS;QT;EXTERNAL" ${ARGN})
    _argus_gcs_check_rule(${module} "${ARG_DEPS}" "${ARG_QT}" "${ARG_EXTERNAL}")
    add_executable(${name} ${ARG_SOURCES})
    # 실행 파일은 빌드 폴더 맨 위에 둔다 (build/gcs/argus_gcs)
    set_target_properties(${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
    target_link_libraries(${name} PRIVATE argus_gcs_warnings)
    _argus_gcs_link(${name} PRIVATE ${module} "${ARG_DEPS}" "${ARG_QT}" "${ARG_EXTERNAL}")
endfunction()

# Qt Test: test/<이름>_test.cpp 마다 실행 파일 하나와 add_test 하나
function(argus_gcs_add_test name)
    cmake_parse_arguments(ARG "" "" "SOURCES;LIBS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE ${ARG_LIBS} Qt6::Test argus_gcs_warnings)
    add_test(NAME ${name} COMMAND ${name})
endfunction()

# include 검사(check_module_deps.cmake)가 읽는 모듈 목록을 쓴다. 모든 모듈을 추가한 뒤 한 번 부른다
function(argus_gcs_write_module_list path)
    get_property(modules GLOBAL PROPERTY ARGUS_GCS_MODULES)
    set(content "set(ARGUS_GCS_MODULES \"${modules}\")\n")
    foreach(module IN LISTS modules)
        get_property(dir GLOBAL PROPERTY ARGUS_GCS_MODULE_${module}_DIR)
        get_property(deps GLOBAL PROPERTY ARGUS_GCS_MODULE_${module}_DEPS)
        string(APPEND content "set(ARGUS_GCS_MODULE_${module}_DIR \"${dir}\")\n")
        string(APPEND content "set(ARGUS_GCS_MODULE_${module}_DEPS \"${deps}\")\n")
    endforeach()
    file(WRITE ${path} "${content}")
endfunction()
